  "plan": [
    {
      "session": "Finger",
      "what": "20mm half-crimp max hangs and one-arm progressions, left hand first. Two weeks in three; the third week is open-hand drag and repeaters, submaximal.",
      "load": "Fingers: high",
      "spacing": "At least 2 days from Board"
    },
    {
      "session": "Board",
      "what": "Tension benchmark lists or MoonBoard benchmarks (both at 40°), alternating.",
      "load": "Fingers and skin: high",
      "spacing": "At least 2 days from Finger"
    },
    {
      "session": "Pull",
      "what": "Weighted pullups, lockoffs, one-arm declines. Rotator cuff once a week. Shoulder strength is tracked here.",
      "load": "Shoulders: high; fingers: low",
      "spacing": "Can sit next to Finger or Board"
    },
    {
      "session": "Weakness",
      "what": "Gym strengthening for your weak spots: pinch block lifts, heel hook floor raises, ring face pulls, open hand drag, shoulder Y's to I's and sloper rollers.",
      "load": "Low",
      "spacing": "Light day: best the day after a heavy session"
    },
    {
      "session": "Stretching",
      "what": "Three 10–15 minute slots a week, on rest days or after sessions.",
      "load": "Low",
      "spacing": "Any day; not counted as a session"
    }
  ],
  "rules": [
    {
      "title": "Spacing",
      "text": "Finger and Board go at least 48 hours apart, because they load the same tissues."
    },
    {
      "title": "Light day",
      "text": "Weakness is your light day. Do it the day after something heavy."
    },
    {
      "title": "Pull day",
      "text": "Can sit next to either Finger or Board, since it is easy on the fingers."
    },
    {
      "title": "What to do next",
      "text": "Do whichever session is most overdue that the rules allow. If you are tired or your fingers are sore, drop to Weakness or stretching."
    },
    {
      "title": "Full week",
      "text": "Four sessions: Finger, Board, Pull, Weakness."
    },
    {
      "title": "Three-session week",
      "text": "Finger, Board, and Pull with Weakness at the end."
    },
    {
      "title": "Finger rotation",
      "text": "Two weeks of heavy half-crimp toward the one-arm hang, then one week of open-hand drag and repeaters (submaximal)."
    },
    {
      "title": "Weaker hand",
      "text": "Left hand goes first in every set."
    },
    {
      "title": "Rotator cuff",
      "text": "Once a week, with Pull."
    },
    {
      "title": "Shoulders",
      "text": "Trained on Pull day and tracked there, not as a separate weakness block."
    },
    {
      "title": "Boards",
      "text": "Tension climbs are tracked as Tension 1 to 3 and MoonBoard as its benchmark list, both boards at 40°. Log the number of tries on each climb you send."
    },
    {
      "title": "Readiness",
      "text": "Log a 1 to 5 on each session. 1 or 2 means a light day."
    },
    {
      "title": "Assumption",
      "text": "Strength figures are Tindeq peak pull (force, not added weight). Holding a one-arm hang needs margin over a one-off peak."
    }
  ],
